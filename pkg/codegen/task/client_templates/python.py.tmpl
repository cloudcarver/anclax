class RetryPolicy(TypedDict):
    interval: str
    maxAttempts: int


class Cronjob(TypedDict):
    cronExpression: str


class TaskAttributes(TypedDict, total=False):
    timeout: str
    retryPolicy: RetryPolicy
    cronjob: Cronjob
    labels: list[str]
    tags: list[str]
    priority: int
    weight: int
    serialKey: str
    serialID: int
    releaseUniqueTagOnTerminal: bool


@dataclass(frozen=True, kw_only=True)
class TaskOptions:
    unique_tag: str | None = None
    parent_task_id: int | None = None
    started_at: datetime | None = None
    delay: timedelta | None = None
    attributes: TaskAttributes | None = None


class Database(Protocol):
    """Implemented by asyncpg.Connection and asyncpg.Pool with default JSON codecs."""

    async def fetchrow(self, query: str, *args: Any) -> Mapping[str, Any] | None: ...

    async def execute(self, query: str, *args: Any) -> str: ...


_SYSTEM_TASKS = frozenset({
    "prefetchTasks", "broadcastUpdateWorkerRuntimeConfig", "applyWorkerRuntimeConfigToWorker",
    "broadcastCancelTask", "cancelTaskOnWorker", "broadcastPauseTask", "pauseTaskOnWorker",
})


def _int32(value: Any, name: str, minimum: int = -(2**31)) -> int:
    if type(value) is not int or not minimum <= value <= 2**31 - 1:
        raise ValueError(f"{name} must be an int32 >= {minimum}")
    return value


def _strings(value: Any, name: str) -> None:
    if not isinstance(value, (list, tuple)) or any(not isinstance(item, str) for item in value):
        raise ValueError(f"{name} must be a list of strings")


def _record(row: Mapping[str, Any] | None) -> dict[str, Any] | None:
    if row is None:
        return None
    result = dict(row)
    for key in ("attributes", "spec"):
        if isinstance(result.get(key), str):
            result[key] = json.loads(result[key])
    return result


class TaskClient:
    def __init__(self, db: Database):
        """Use an application-owned asyncpg pool or connection.

        For atomic business writes and task creation, pass the same connection
        used by the business transaction. Passing a pool does not join a
        transaction on an acquired connection. The caller manages transactions
        and connection release; this constructor only stores the reference.

        Example:
            async with pool.acquire() as conn, conn.transaction():
                client = Client(conn)
                # Business SQL on conn and task calls on client share the transaction.
        """
        self._db = db

    async def enqueue(
        self,
        task_type: str,
        payload: Any,
        *,
        options: TaskOptions | None = None,
        attributes: TaskAttributes | None = None,
        delay_seconds: float | None = None,
    ) -> int:
        """Insert pending work, or return the ID already owning its unique tag.

        A caller-owned connection can enlist this operation in its transaction.
        No transaction is started or committed by the client. Database errors and
        asyncio cancellation propagate to the caller, including serialization failures.
        """
        options = options or TaskOptions()
        if not isinstance(task_type, str) or not task_type or task_type == "prefetchTasks":
            raise ValueError("task_type must be nonempty and cannot be prefetchTasks")
        if options.unique_tag is not None:
            if not isinstance(options.unique_tag, str):
                raise ValueError("unique_tag must be a string")
            if options.unique_tag.startswith("anclax:system:"):
                raise ValueError("anclax:system: unique tags are reserved for the worker runtime")
        attrs: TaskAttributes = {**(attributes or {}), **(options.attributes or {})}
        priority = _int32(attrs.get("priority", 0), "priority", 0)
        weight = _int32(attrs.get("weight", 1), "weight", 1)
        attrs["priority"] = priority
        attrs["weight"] = weight
        serial_key, serial_id = attrs.get("serialKey"), attrs.get("serialID")
        if serial_key is not None and (not isinstance(serial_key, str) or not serial_key):
            raise ValueError("serialKey must be a nonempty string")
        if serial_id is not None:
            _int32(serial_id, "serialID")
            if serial_key is None:
                raise ValueError("serialID requires serialKey")
        if options.parent_task_id is not None:
            _int32(options.parent_task_id, "parent_task_id")
        for key in ("labels", "tags"):
            if key in attrs:
                _strings(attrs[key], key)
        if "releaseUniqueTagOnTerminal" in attrs and type(attrs["releaseUniqueTagOnTerminal"]) is not bool:
            raise ValueError("releaseUniqueTagOnTerminal must be a boolean")
        if task_type in _SYSTEM_TASKS and (attrs.get("tags") or serial_key is not None or weight != 1):
            raise ValueError("system tasks do not support tags, serial scheduling or weights")
        started_at = options.started_at
        if started_at is not None:
            if options.delay is not None:
                raise ValueError("started_at and delay are mutually exclusive")
            if not isinstance(started_at, datetime) or started_at.utcoffset() is None:
                raise ValueError("started_at must be a timezone-aware datetime")
        else:
            delay = options.delay
            if delay is None and delay_seconds is not None:
                delay = timedelta(seconds=delay_seconds)
            if delay is not None:
                started_at = datetime.now(timezone.utc) + delay
        args = (
            json.dumps(attrs, allow_nan=False),
            json.dumps({"type": task_type, "payload": payload}, allow_nan=False),
            "pending", started_at, options.unique_tag, options.parent_task_id,
            serial_key, serial_id, priority, weight,
        )
        if options.unique_tag is not None:
            existing = await self._db.fetchrow(_SQL.GetTaskByUniqueTag, options.unique_tag)
            if existing is not None:
                return existing["id"]
        while True:
            row = await self._db.fetchrow(_SQL.CreateTask, *args)
            if row is not None:
                return row["id"]
            if options.unique_tag is None:
                raise RuntimeError("task insert returned no row without a unique tag")
            # A separate statement sees concurrent commits under READ COMMITTED.
            # The winner can release its tag before this lookup; then retry insertion.
            existing = await self._db.fetchrow(_SQL.GetTaskByUniqueTag, options.unique_tag)
            if existing is not None:
                return existing["id"]

    async def get_task_by_id(self, task_id: int) -> dict[str, Any] | None:
        return _record(await self._db.fetchrow(_SQL.GetTaskByID, _int32(task_id, "task_id")))

    async def get_task_by_unique_tag(self, unique_tag: str) -> dict[str, Any] | None:
        return _record(await self._db.fetchrow(_SQL.GetTaskByUniqueTag, unique_tag))

    async def get_last_task_error_event(self, task_id: int) -> dict[str, Any] | None:
        return _record(await self._db.fetchrow(_SQL.GetLastTaskErrorEvent, _int32(task_id, "task_id")))

    async def update_pending_task_priority_by_labels(self, labels: Sequence[str], priority: int) -> int:
        _strings(labels, "labels")
        result = await self._db.execute(_SQL.UpdatePendingTaskPriorityByLabels,
                                        _int32(priority, "priority", 0), bool(labels), list(labels))
        return int(result.split()[-1])

    async def update_pending_task_weight_by_labels(self, labels: Sequence[str], weight: int) -> int:
        _strings(labels, "labels")
        result = await self._db.execute(_SQL.UpdatePendingTaskWeightByLabels,
                                        _int32(weight, "weight", 1), bool(labels), list(labels))
        return int(result.split()[-1])
