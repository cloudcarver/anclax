/** Compatible with pg.Pool, pg.Client and pg.PoolClient using default type parsers. */
export interface Database {
  query(text: string, values?: any[]): Promise<{ rows: any[]; rowCount: number | null }>;
}

export interface TaskAttributes {
  timeout?: string;
  retryPolicy?: { interval: string; maxAttempts: number };
  cronjob?: { cronExpression: string };
  labels?: string[];
  tags?: string[];
  priority?: number;
  weight?: number;
  serialKey?: string;
  serialID?: number;
  releaseUniqueTagOnTerminal?: boolean;
}

export interface TaskOptions {
  uniqueTag?: string;
  parentTaskId?: number;
  startedAt?: Date;
  /** Replaces the delay from the task spec. Mutually exclusive with startedAt. */
  delayMs?: number;
  /** Shallow overrides of the attributes from the task spec. */
  attributes?: TaskAttributes;
}

/** Database column names, with JSONB values decoded by pg. */
export interface TaskRecord {
  id: number;
  attributes: TaskAttributes;
  spec: { type: string; payload: unknown };
  status: string;
  unique_tag: string | null;
  parent_task_id: number | null;
  started_at: Date | null;
  created_at: Date;
  updated_at: Date;
  attempts: number;
  serial_key: string | null;
  serial_id: number | null;
  priority: number;
  weight: number;
}

export interface TaskErrorEvent {
  id: number;
  spec: { type: string; taskError?: { taskID: number; error: string } };
  created_at: Date;
}

export class TaskClient {
  constructor(db: Database);
  /** Never starts/commits a transaction; database errors propagate unchanged. */
  enqueue(taskType: string, payload: unknown, options?: TaskOptions,
          defaults?: { attributes?: TaskAttributes; delayMs?: number }): Promise<number>;
  getTaskByID(taskID: number): Promise<TaskRecord | null>;
  getTaskByUniqueTag(uniqueTag: string): Promise<TaskRecord | null>;
  getLastTaskErrorEvent(taskID: number): Promise<TaskErrorEvent | null>;
  /** Matches any supplied label; an empty list selects unlabeled pending tasks. */
  updatePendingTaskPriorityByLabels(labels: string[], priority: number): Promise<number>;
  updatePendingTaskWeightByLabels(labels: string[], weight: number): Promise<number>;
}
